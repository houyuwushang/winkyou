batchmode=yes
canonicalizehostname=no
checkhostip=no
clearallforwardings=yes
connectionattempts=1
connecttimeout=3
controlmaster=no
controlpersist=no
escapechar=none
forwardagent=no
forwardx11=no
globalknownhostsfile=none
gssapiauthentication=no
hostname=127.0.0.1
identitiesonly=yes
identityagent=none
kbdinteractiveauthentication=no
numberofpasswordprompts=0
passwordauthentication=no
permitlocalcommand=no
port=22
proxycommand=none
proxyjump=none
pubkeyauthentication=yes
sessiontype=default
stricthostkeychecking=yes
tunnel=no
updatehostkeys=no
user=gate-c-user
verifyhostkeydns=no
