executable=C:\Windows\System32\OpenSSH\ssh.exe
environment=SYSTEMROOT=C:\Windows;WINDIR=C:\Windows;PROGRAMDATA=C:\ProgramData
-F
none
-T
-i
<IDENTITY>
-p
22
-o
BatchMode=yes
-o
NumberOfPasswordPrompts=0
-o
PasswordAuthentication=no
-o
KbdInteractiveAuthentication=no
-o
GSSAPIAuthentication=no
-o
PubkeyAuthentication=yes
-o
IdentitiesOnly=yes
-o
IdentityAgent=none
-o
StrictHostKeyChecking=yes
-o
UpdateHostKeys=no
-o
VerifyHostKeyDNS=no
-o
CheckHostIP=no
-o
UserKnownHostsFile=<KNOWN_HOSTS>
-o
GlobalKnownHostsFile=none
-o
ControlMaster=no
-o
ControlPersist=no
-o
ControlPath=none
-o
ProxyCommand=none
-o
ProxyJump=none
-o
CanonicalizeHostname=no
-o
ClearAllForwardings=yes
-o
ForwardAgent=no
-o
ForwardX11=no
-o
Tunnel=no
-o
PermitLocalCommand=no
-o
SessionType=default
-o
EscapeChar=none
-o
ConnectionAttempts=1
-o
ConnectTimeout=3
-o
User=gate-c-user
127.0.0.1
wink solver direct child --stdio
